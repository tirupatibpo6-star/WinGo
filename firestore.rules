rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tirupatibpo6@gmail.com' ||
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.matches('(?i)tirupatibpo6@gmail\\.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSubadmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.role == 'subadmin' ||
        (isSubadmin() && resource.data.referredBy == request.auth.uid) ||
        resource.data.referralCode != null
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isSubadmin() && (request.auth.uid == userId || resource.data.referredBy == request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isSubadmin() && request.resource.data.fromUid == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /gateways/{gatewayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recharges/{rechargeId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
